{
  "expo": {
    "name": "CampaignHQ",
    "slug": "campaignhq-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icons/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campaignhq.mobile"
    },
    "android": {
      "package": "com.campaignhq.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon-foreground.png",
        "backgroundColor": "#FFF8EC"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8EC"
        }
      ]
    ]
  }
}